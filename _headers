# Cloudflare Pages _headers — CF docs are explicit that `*` matches
# any character EXCLUDING `/`. So `/*` matches `/foo.css` but does NOT
# match `/styles/foo.css`. Earlier attempts at a `/*` catch-all left
# every CSS/JS file on Cloudflare's default 4-hour cache, which means
# real CSS changes took up to 4 hours to reach a returning visitor's
# browser. Listing each subdir explicitly to force revalidation.

/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/sections/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Pages Functions — never cache the response.
/api/*
  Cache-Control: no-store

# Fonts / video / images: rarely change, large, safe to long-cache.
/assets/*
  Cache-Control: public, max-age=604800, immutable

/assets/fonts/*
  Cache-Control: public, max-age=604800, immutable

/assets/images/*
  Cache-Control: public, max-age=604800, immutable

/assets/video/*
  Cache-Control: public, max-age=604800, immutable
