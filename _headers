# Cloudflare Pages cache control.
# Default Pages cache for static assets is generous, which means a deploy
# of scripts/*.js or styles/*.css can take hours to reach a browser that
# already has the old file cached. Force revalidation so every page load
# re-checks freshness (ETag returns 304 when nothing changed — cheap).
#
# HTML is left to Pages' defaults (always revalidated by Cloudflare).
# Assets in /assets (fonts, video, images) keep long cache because they
# are large and rarely change; bump their filename if you need to bust.

/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

/functions/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=604800
